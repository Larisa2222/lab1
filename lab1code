#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <limits.h>
#include <float.h>
#include <math.h>
#define true 1
#define false 0
typedef enum {
    TYPE_INT,
    TYPE_DOUBLE
} DataType;
typedef struct {
    char *name;
    DataType type;
    long long count;
    long long min_int;
    long long max_int;
    double sum_int_exact; 
    long long positive_int;
    long long negative_int;
    long long even_int;
    double min_double;
    double max_double;
    double sum_double;
    long long positive_double;
    long long negative_double;
    long long integer_double;
} Column;
char *read_csv_field(FILE *stream, int *is_eol);
void init_column(Column *col, char *name);
void free_column_resources(Column *col);
int is_integer_string(const char *str);
void process_value(Column *col, const char *val_str);
void print_double_safe(double val);
void print_stats(Column *cols, int col_count, int mode_schema, int mode_stats);
char *read_csv_field(FILE *stream, int *is_eol) {
    size_t capacity = 16;
    size_t len = 0;
    char *buf = malloc(capacity);
    if (!buf) return NULL;
    int c;
    *is_eol = false;
    while (true) {
        c = fgetc(stream);
        if (c == EOF) {
            *is_eol = true;
            break;
        }
        if (c == '\r') {
            continue; 
        }
        if (c == '\n') {
            *is_eol = true;
            break;
        }
        if (c == ',') {
            break;
        }
        if (len + 1 >= capacity) {
            capacity *= 2;
            char *new_buf = realloc(buf, capacity);
            if (!new_buf) {
                free(buf);
                return NULL;
            }
            buf = new_buf;
        }
        buf[len++] = (char)c;
    }
    if (c == EOF && len == 0) {
        free(buf);
        return NULL;
    }
    buf[len] = '\0';
    return buf;
}
void init_column(Column *col, char *name) {
    col->name = name; 
    col->type = TYPE_INT;
    col->count = 0;
    col->min_int = LLONG_MAX;
    col->max_int = LLONG_MIN;
    col->sum_int_exact = 0.0;
    col->positive_int = 0;
    col->negative_int = 0;
    col->even_int = 0;
    col->min_double = DBL_MAX;
    col->max_double = -DBL_MAX;
    col->sum_double = 0.0;
    col->positive_double = 0;
    col->negative_double = 0;
    col->integer_double = 0;
}
void free_column_resources(Column *col) {
    if (col && col->name) {
        free(col->name);
        col->name = NULL;
    }
}
int is_integer_string(const char *str) {
    if (!str || *str == '\0') return false;
    if (*str == '-' || *str == '+') str++;
    if (*str == '\0') return false;
    while (*str) {
        if (*str < '0' || *str > '9') return false;
        str++;
    }
    return true;
}
void process_value(Column *col, const char *val_str) {
    if (!val_str || *val_str == '\0') {
        return; 
    }
    int token_is_int = is_integer_string(val_str);
    if (col->type == TYPE_INT && !token_is_int) {
        col->type = TYPE_DOUBLE;
        if (col->count > 0) {
            col->min_double = (double)col->min_int;
            col->max_double = (double)col->max_int;
            col->sum_double = col->sum_int_exact;
            col->positive_double = col->positive_int;
            col->negative_double = col->negative_int;
            col->integer_double = col->count; 
        }
    }
    if (col->type == TYPE_INT) {
        long long val = strtoll(val_str, NULL, 10);
        if (val < col->min_int) col->min_int = val;
        if (val > col->max_int) col->max_int = val;
        col->sum_int_exact += (double)val;        
        if (val > 0) col->positive_int++;
        if (val < 0) col->negative_int++;
        if (val % 2 == 0) col->even_int++;
    } else {
        char *endptr;
        double val = strtod(val_str, &endptr);
        if (endptr == val_str) return;
        if (val < col->min_double) col->min_double = val;
        if (val > col->max_double) col->max_double = val;
        col->sum_double += val;
        if (val > 0.0) col->positive_double++;
        if (val < 0.0) col->negative_double++;
        if (floor(val) == val) col->integer_double++;
    }
    col->count++;
}
void print_double_safe(double val) {
    val += 0.0; 
    if (fabs(val) < 1e-7 || round(val * 1000000.0) == 0.0) {
        printf("0.000000");
    } else {
        printf("%f", val);
    }
}
void print_stats(Column *cols, int col_count, int mode_schema, int mode_stats) {
    if (mode_schema) {
        for (int i = 0; i < col_count; i++) {
            printf("%s:%s\n", cols[i].name, (cols[i].type == TYPE_INT) ? "INT" : "DOUBLE");
        }
    } else if (mode_stats) {
        for (int i = 0; i < col_count; i++) {
            if (cols[i].type == TYPE_INT) {
                double mean = cols[i].sum_int_exact / cols[i].count;
                printf("column %d name \"%s\"\n", i, cols[i].name);
                printf("type INT\n");
                printf("nulls 0 min %lld max %lld mean ", cols[i].min_int, cols[i].max_int);
                print_double_safe(mean);
                printf("\n");
                printf("positive %lld negative %lld even %lld\n", 
                       cols[i].positive_int, cols[i].negative_int, cols[i].even_int);
            } else {
                double mean = cols[i].sum_double / cols[i].count;
                printf("column %d name \"%s\"\n", i, cols[i].name);
                printf("type DOUBLE\n");
                printf("nulls 0 min ");
                print_double_safe(cols[i].min_double);
                printf(" max ");
                print_double_safe(cols[i].max_double);
                printf(" mean ");
                print_double_safe(mean);
                printf("\n");
                printf("positive %lld negative %lld integer %lld\n", 
                       cols[i].positive_double, cols[i].negative_double, cols[i].integer_double);
            }
        }
    }
}
int main(int argc, char *argv[]) {
    if (argc != 2) {
        fprintf(stderr, "Usage: %s [-help | -schema | -stats]\n", argv[0]);
        return 1;
    }
    if (strcmp(argv[1], "-help") == 0) {
        printf("CSV Statistics Tool (csvstat)\n");
        return 0;
    }
    int mode_schema = (strcmp(argv[1], "-schema") == 0);
    int mode_stats = (strcmp(argv[1], "-stats") == 0);
    if (!mode_schema && !mode_stats) {
        fprintf(stderr, "Error: Unknown option %s\n", argv[1]);
        return 1;
    }
    int col_capacity = 8;
    int col_count = 0;
    Column *cols = malloc(col_capacity * sizeof(Column));
    if (!cols) return 1;
    int is_eol = false;
    while (!is_eol) {
        char *field_name = read_csv_field(stdin, &is_eol);
        if (!field_name) break;
        if (col_count >= col_capacity) {
            col_capacity *= 2;
            Column *new_cols = realloc(cols, col_capacity * sizeof(Column));
            if (!new_cols) {
                free(field_name);
                for (int i = 0; i < col_count; i++) free_column_resources(&cols[i]);
                free(cols);
                return 1;
            }
            cols = new_cols;
        }
        init_column(&cols[col_count], field_name);
        col_count++;
    }
    if (col_count == 0) {
        free(cols);
        return 0;
    }
    int current_col = 0;
    is_eol = false;
    while (true) {
        char *val_str = read_csv_field(stdin, &is_eol);
        if (!val_str) {
            break; 
        }
        if (current_col < col_count) {
            process_value(&cols[current_col], val_str);
        }
        free(val_str); 
        if (is_eol) {
            current_col = 0;
        } else {
            current_col++;
        }
    }
    print_stats(cols, col_count, mode_schema, mode_stats);
    for (int i = 0; i < col_count; i++) {
        free_column_resources(&cols[i]);
    }
    free(cols);
    return 0;
}
